#!/bin/bash
# SSH into the user's MacBook Air over Tailscale.
# NOTE: the exec shell runs as root (HOME=/root), so the identity file must be given explicitly.
exec ssh -i $HOME/.ssh/id_ed25519 -o IdentitiesOnly=yes \
  -o ProxyCommand="$HOME/workspace/.bin/ts-proxy.sh %h %p" \
  -o BatchMode=yes -o StrictHostKeyChecking=accept-new -o ConnectTimeout=25 \
  <ユーザー名>@<MacのTailscale IP> "$@"
